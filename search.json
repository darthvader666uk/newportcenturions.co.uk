---
layout: null
sitemap: false
---
[
  {%- assign docs = site.pages | where_exp: "p", "p.title" -%}
  {%- for page in docs -%}
    {%- unless page.url contains '.json' or page.url contains '.txt' or page.url contains '.xml' or page.url == '/404.html' or page.url == '/thank-you/' or page.url == '/search/' -%}
  {
    "title": {{ page.title | jsonify }},
    "url": {{ page.url | jsonify }},
    "description": {{ page.description | default: '' | jsonify }},
    "keywords": {{ page.keywords | default: '' | jsonify }},
    "body": {{ page.content | strip_html | normalize_whitespace | truncate: 2000 | jsonify }},
    "type": "page"
  },
    {%- endunless -%}
  {%- endfor %}
  null
]
